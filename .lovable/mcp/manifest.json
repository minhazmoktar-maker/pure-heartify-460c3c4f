{
  "version": 1,
  "sdk_version": "0.20.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://tbgxtwgliumqqtuppztu.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "heartify-mcp",
      "version": "0.1.0",
      "title": "Heartify"
    },
    "tools": [
      {
        "name": "get_profile",
        "title": "Get profile",
        "description": "Return the signed-in Heartify user's profile (display name, locale, timezone, preferred reciter).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_streak",
        "title": "Get daily-dose streak",
        "description": "Return the signed-in user's current streak, longest streak, and total daily doses completed.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_favorites",
        "title": "List favorites",
        "description": "List the signed-in user's favorited Heartify videos (most recent first).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 25,
              "description": "How many favorites to return.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_dhikr_sessions",
        "title": "List recent dhikr sessions",
        "description": "Return the signed-in user's recent dhikr sessions, most recent first. Supports pagination via limit + offset.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 25,
              "description": "Max sessions to return (1–100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "default": 0,
              "description": "Rows to skip for pagination.",
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "dhikr_key": {
              "default": null,
              "description": "Optional filter by dhikr key.",
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_salah_logs",
        "title": "List recent salah logs",
        "description": "Return the signed-in user's recent salah (prayer) logs, most recent first. Supports pagination and optional prayer-name filter.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 25,
              "description": "Max rows to return (1–100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "default": 0,
              "description": "Rows to skip for pagination.",
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "prayer": {
              "default": null,
              "description": "Optional filter by prayer name.",
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "fajr",
                    "dhuhr",
                    "asr",
                    "maghrib",
                    "isha"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "log_dhikr_session",
        "title": "Log a dhikr session",
        "description": "Record a dhikr (remembrance) session for the signed-in user. Use for tasbih counts like SubhanAllah, Alhamdulillah, Allahu Akbar.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "dhikr_key": {
              "type": "string",
              "minLength": 1,
              "description": "Dhikr identifier, e.g. 'subhanallah', 'alhamdulillah', 'allahu-akbar'."
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "description": "Number of repetitions completed."
            },
            "target": {
              "default": null,
              "description": "Optional target count for the session.",
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "dhikr_key",
            "count"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "log_salah",
        "title": "Log a prayer (salah)",
        "description": "Record a completed prayer for the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "prayer": {
              "type": "string",
              "enum": [
                "fajr",
                "dhuhr",
                "asr",
                "maghrib",
                "isha"
              ],
              "description": "Which of the five daily prayers."
            },
            "prayer_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Prayer date in YYYY-MM-DD."
            },
            "on_time": {
              "default": true,
              "description": "Whether the prayer was prayed on time.",
              "type": "boolean"
            },
            "notes": {
              "default": null,
              "description": "Optional short notes.",
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "prayer",
            "prayer_date"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "get_prayer_times",
        "title": "Get prayer times",
        "description": "Return today's five daily prayer times for a location. Uses Heartify's public prayer-times endpoint.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90,
              "description": "Latitude in decimal degrees."
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180,
              "description": "Longitude in decimal degrees."
            },
            "date": {
              "default": null,
              "description": "Date YYYY-MM-DD (defaults to today).",
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "method": {
              "default": "MWL",
              "description": "Calculation method.",
              "type": "string",
              "enum": [
                "MWL",
                "ISNA",
                "Egypt",
                "Makkah",
                "Karachi",
                "Tehran",
                "Jafari"
              ]
            }
          },
          "required": [
            "lat",
            "lng"
          ]
        },
        "outputSchema": null
      }
    ]
  }
}
