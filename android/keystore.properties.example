# Copy this file to android/keystore.properties (never committed) and fill in
# the values for YOUR upload keystore. Do not share or commit the real file.
#
# storeFile may be an absolute path (Windows example: C:\\keys\\heartify-upload.jks)
storeFile=C:\\keys\\heartify-upload.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=heartify
keyPassword=YOUR_KEY_PASSWORD
