<?xml version="1.0" encoding="utf-8"?>
<!--
  Heartify — per-app language configuration (Android 13+ / API 33).

  Generated from src/config/globalization.ts (APP_LOCALES). Declaring locales
  here is what puts Heartify in Settings > System > Languages > App languages,
  the same way YouTube and other global apps let users pick an app language
  independent of the device language.

  Wire it up in android/app/src/main/AndroidManifest.xml:

    <application
        android:localeConfig="@xml/locales_config"
        ... >

  and in android/app/build.gradle so the resources survive shrinking:

    android {
      defaultConfig {
        resourceConfigurations += [
          "en","en-rGB","ar","bn","bn-rIN","ur","ur-rIN","fa","ps","id","ms",
          "tr","ha","sw","fr","de","es","b+es+419","pt-rPT","pt-rBR",
          "zh-rCN","zh-rTW","ja","ko"
        ]
      }
    }

  RTL locales (ar, ur, ps, fa) additionally require
  android:supportsRtl="true" on <application>.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Launch region: South Asia -->
    <locale android:name="bn" />
    <locale android:name="bn-IN" />
    <locale android:name="ur" />
    <locale android:name="ur-IN" />
    <locale android:name="ps" />
    <!-- English (default + diaspora) -->
    <locale android:name="en" />
    <locale android:name="en-GB" />
    <!-- Arabic & Persianate -->
    <locale android:name="ar" />
    <locale android:name="fa" />
    <locale android:name="tr" />
    <!-- Southeast Asia -->
    <locale android:name="id" />
    <locale android:name="ms" />
    <!-- Africa -->
    <locale android:name="ha" />
    <locale android:name="sw" />
    <!-- Europe & Americas -->
    <locale android:name="fr" />
    <locale android:name="de" />
    <locale android:name="es" />
    <locale android:name="es-419" />
    <locale android:name="pt-PT" />
    <locale android:name="pt-BR" />
    <!-- East Asia -->
    <locale android:name="zh-Hans" />
    <locale android:name="zh-Hant" />
    <locale android:name="ja" />
    <locale android:name="ko" />
</locale-config>
