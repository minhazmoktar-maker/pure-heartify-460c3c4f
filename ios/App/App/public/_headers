# Security headers applied at the hosting/CDN layer.
# Verified by .github/workflows/header-audit.yml on every push.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-XSS-Protection: 0
  Report-To: {"group":"csp-endpoint","max_age":10886400,"endpoints":[{"url":"https://tbgxtwgliumqqtuppztu.supabase.co/functions/v1/csp-report"}]}
  Reporting-Endpoints: csp-endpoint="https://tbgxtwgliumqqtuppztu.supabase.co/functions/v1/csp-report"
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.youtube.com https://s.ytimg.com https://www.googletagmanager.com https://browser.sentry-cdn.com https://*.sentry.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; report-uri https://tbgxtwgliumqqtuppztu.supabase.co/functions/v1/csp-report; report-to csp-endpoint

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/sitemaps/*
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600
