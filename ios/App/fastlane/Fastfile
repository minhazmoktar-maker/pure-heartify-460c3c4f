default_platform(:ios)

# Release notes shown to TestFlight testers. Override per run with:
#   BETA_CHANGELOG="Fixes offline downloads" bundle exec fastlane beta
def beta_changelog
  ENV["BETA_CHANGELOG"] || "Internal build #{ENV['GITHUB_RUN_NUMBER'] || Time.now.strftime('%Y-%m-%d %H:%M')} — see CHANGELOG for details."
end

# Optional comma-separated TestFlight internal group names.
def beta_groups
  groups = (ENV["TESTFLIGHT_GROUPS"] || "").split(",").map(&:strip).reject(&:empty?)
  groups.empty? ? nil : groups
end

platform :ios do
  desc "Build and upload to TestFlight (Internal Testing)"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
      key_filepath: File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_PATH"]),
      in_house: false,
    )

    # Signing assets live in the private `match` repo. readonly: true means CI
    # never mints new certificates (it would invalidate other machines').
    match(
      type: "appstore",
      readonly: true,
      git_url: ENV["MATCH_GIT_URL"],
      team_id: ENV["IOS_TEAM_ID"],
      api_key: api_key,
    )

    # Build numbers must strictly increase per upload; a UTC timestamp is
    # monotonic even across re-runs and parallel branches.
    increment_build_number(
      xcodeproj: "App.xcodeproj",
      build_number: Time.now.utc.strftime("%Y%m%d%H%M"),
    )

    build_app(
      workspace: "App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      # Processing can take 10-30 min; don't hold a macOS runner hostage.
      skip_waiting_for_build_processing: true,
      # Internal testers only — external groups require App Review of the beta.
      distribute_external: false,
      changelog: beta_changelog,
      groups: beta_groups,
    )
  end

  desc "Verify signing + build locally without uploading"
  lane :build_only do
    match(type: "appstore", readonly: true, git_url: ENV["MATCH_GIT_URL"], team_id: ENV["IOS_TEAM_ID"])
    build_app(workspace: "App.xcworkspace", scheme: "App", export_method: "app-store", clean: true)
  end
end
